# Copy to .env and fill in. Never commit .env.

# --- LLM backend -------------------------------------------------------------
# "bifrost" -> the Avo Bifrost gateway (preferred; budget + routing live there)
# "azure"   -> an Azure OpenAI deployment, called directly
# "mock"    -> offline rule-based negotiator, no network, no cost
LLM_MODE=mock

# Bifrost. The gateway origin only — no /openai or /v1 suffix. The model is
# "<provider>/<model>"; for Azure the part after the slash is the deployment name.
BIFROST_BASE_URL=https://<your-bifrost-host>
BIFROST_VIRTUAL_KEY=
BIFROST_MODEL=azure/gpt-5.4-mini

# Azure direct (only read when LLM_MODE=azure)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Event access ------------------------------------------------------------
JOIN_CODE=AVO2026
ADMIN_CODE=changeme-admin

# --- Optional ----------------------------------------------------------------
# Override the gatekeeper secret without editing config.yaml
# GATEKEEPER_SECRET=ROSEBUD
# Where the crash-recovery snapshot is written
# SNAPSHOT_PATH=snapshot.json
